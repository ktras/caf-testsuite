COMPILER="llvm"
#FC="flang"
LLVM_PATH="${HOME}/opt/llvm-sipearl/bin"
FC="${LLVM_PATH}/flang"
CC="${LLVM_PATH}/clang"

CAFFEINE_PATH="$HOME/opt/caffeine/lib"
LIB_CAF="-fcoarray -L${CAFFEINE_PATH} -lcaffeine -Wl,-rpath,${CAFFEINE_PATH}"
FFLAGS="-cpp -DCO_REDUCTIONS_SUPPORT ${LIB_CAF}"

LAUNCHER=""
EXEC_OPTIONS=""

COMPILE_CMD="${FC} ${FFLAGS} ${FFLAGS_BENCH_DEFS}"

